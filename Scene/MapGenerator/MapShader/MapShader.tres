[resource]
code = "shader_type canvas_item;
render_mode blend_mix;

instance uniform vec4 Color : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
instance uniform float FloatParameter = 0.0;
uniform sampler2D tex_frg_16 : source_color;
instance uniform float worley_weight : hint_range(0.0, 1.0) = 0.0;
uniform float circle_weight : hint_range(0.0, 1.0) = 0.0;
instance uniform float down_bound : hint_range(0.0, 1.0) = 0.30000001192093;
instance uniform float up_bound : hint_range(0.0, 1.0) = 0.34999999403954;
uniform sampler2D tex_frg_42;


// GradientNoise
#include \"res://addons/ShaderLib_v2_2_4/Procedural/Procedural.gdshaderinc\"
// GlobalExpression:0
	float signed_angle(vec2 a, vec2 b) {
	    float angle = atan(b.y, b.x) - atan(a.y, a.x);
	    // 確保結果在 -PI 到 PI 之間
	    if (angle > PI) angle -= 2.0 * PI;
	    if (angle < -PI) angle += 2.0 * PI;
	    return (angle+PI)/(PI*2.0); // 弧度
	}
	
// GlobalExpression:1
	vec2 random(vec2 uv) {
		return vec2(fract(sin(dot(uv.xy,
			vec2(12.9898,78.233))) * 43758.5453123));
	}
	
	float worley(vec2 uv, float columns, float rows) {
		
		vec2 index_uv = floor(vec2(uv.x * columns, uv.y * rows));
		vec2 fract_uv = fract(vec2(uv.x * columns, uv.y * rows));
		
		float minimum_dist = 1.0;  
		
		for (int y= -1; y <= 1; y++) {
			for (int x= -1; x <= 1; x++) {
				vec2 neighbor = vec2(float(x),float(y));
				vec2 point = random(index_uv + neighbor);
				
				vec2 diff = neighbor + point - fract_uv;
				float dist = length(diff);
				minimum_dist = min(minimum_dist, dist);
			}
		}
		
		return minimum_dist;
	}

void fragment() {
// ColorParameter:17
	vec4 n_out17p0 = Color;


// FloatParameter:57
	float n_out57p0 = FloatParameter;


// Input:54
	vec2 n_out54p0 = UV;


// VectorOp:55
	vec2 n_out55p0 = vec2(n_out57p0) + n_out54p0;


// Texture2D:16
	vec4 n_out16p0 = texture(tex_frg_16, n_out55p0);


	float n_out60p0;
// Expression:60
	n_out60p0 = 0.0;
	{
		n_out60p0 = 1.0 - worley(n_out55p0, 10.0, 10.0);
	}


	float n_out66p0;
// GradientNoise:66
	float n_in66p1 = 50.00000;
	{
		n_out66p0 = gradient_noise(UV, n_in66p1);
	}


// Mix:67
	float n_in67p2 = 0.50000;
	float n_out67p0 = mix(n_out60p0, n_out66p0, n_in67p2);


// FloatParameter:64
	float n_out64p0 = worley_weight;


// Mix:62
	float n_out62p0 = mix(n_out16p0.x, n_out67p0, n_out64p0);


// Input:20
	vec2 n_out20p0 = UV;


// VectorOp:21
	vec2 n_in21p1 = vec2(0.50000, 0.50000);
	vec2 n_out21p0 = n_out20p0 - n_in21p1;


// VectorLen:26
	float n_out26p0 = length(n_out21p0);


// FloatOp:51
	float n_in51p1 = 2.00000;
	float n_out51p0 = n_out26p0 * n_in51p1;


// FloatOp:50
	float n_in50p0 = 1.00000;
	float n_out50p0 = n_in50p0 - n_out51p0;


// FloatParameter:65
	float n_out65p0 = circle_weight;


// Mix:49
	float n_out49p0 = mix(n_out62p0, n_out50p0, n_out65p0);


// Clamp:52
	float n_in52p1 = 0.00000;
	float n_in52p2 = 1.00000;
	float n_out52p0 = clamp(n_out49p0, n_in52p1, n_in52p2);


// FloatParameter:45
	float n_out45p0 = down_bound;


// Compare:47
	bool n_out47p0 = n_out52p0 > n_out45p0;


// FloatParameter:44
	float n_out44p0 = up_bound;


// Compare:46
	bool n_out46p0 = n_out52p0 < n_out44p0;


// FloatOp:48
	float n_out48p0 = (n_out47p0 ? 1.0 : 0.0) * (n_out46p0 ? 1.0 : 0.0);


// Vector2Constant:35
	vec2 n_out35p0 = vec2(1.000000, 0.000000);


	float n_out34p0;
// Expression:34
	n_out34p0 = 0.0;
	{
		n_out34p0 = signed_angle(n_out21p0, n_out35p0);
	}


// Texture2D:42
	vec4 n_out42p0 = texture(tex_frg_42, vec2(n_out34p0));


// Compare:29
	bool n_out29p0 = n_out42p0.x > n_out26p0;


// FloatOp:43
	float n_out43p0 = n_out48p0 * (n_out29p0 ? 1.0 : 0.0);


// Output:0
	COLOR.rgb = vec3(n_out17p0.xyz);
	COLOR.a = n_out43p0;


}
"
