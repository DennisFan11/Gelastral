[resource]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 ColorParameter : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
uniform sampler2D tex_frg_16;
uniform sampler2D tex_frg_15;
uniform sampler2D tex_frg_42;


// GlobalExpression:0
	float signed_angle(vec2 a, vec2 b) {
	    float angle = atan(b.y, b.x) - atan(a.y, a.x);
	    // 確保結果在 -PI 到 PI 之間
	    if (angle > PI) angle -= 2.0 * PI;
	    if (angle < -PI) angle += 2.0 * PI;
	    return (angle+PI)/(PI*2.0); // 弧度
	}
	

void fragment() {
// ColorParameter:17
	vec4 n_out17p0 = ColorParameter;


// Texture2D:16
	vec4 n_out16p0 = texture(tex_frg_16, UV);


// Texture2D:15
	vec4 n_out15p0 = texture(tex_frg_15, vec2(n_out16p0.xy));


// VectorOp:18
	vec4 n_out18p0 = n_out17p0 * n_out15p0;


// Input:20
	vec2 n_out20p0 = UV;


// VectorOp:21
	vec2 n_in21p1 = vec2(0.50000, 0.50000);
	vec2 n_out21p0 = n_out20p0 - n_in21p1;


// Vector2Constant:35
	vec2 n_out35p0 = vec2(1.000000, 0.000000);


	float n_out34p0;
// Expression:34
	n_out34p0 = 0.0;
	{
		n_out34p0 = signed_angle(n_out21p0, n_out35p0);
	}


// Texture2D:42
	vec4 n_out42p0 = texture(tex_frg_42, vec2(n_out34p0));


// VectorLen:26
	float n_out26p0 = length(n_out21p0);


// Compare:29
	bool n_out29p0 = n_out42p0.x > n_out26p0;


// Output:0
	COLOR.rgb = vec3(n_out18p0.xyz);
	COLOR.a = (n_out29p0 ? 1.0 : 0.0);


}
"
