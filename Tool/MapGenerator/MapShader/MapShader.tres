code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D tex_frg_20 : source_color;
uniform sampler2D tex_frg_19 : source_color;
uniform sampler2D tex_frg_3 : source_color;


// RadialShear
#include \"res://addons/ShaderLib_v2_2_4/UV/UV.gdshaderinc\"
// Spherize
#include \"res://addons/ShaderLib_v2_2_4/UV/UV.gdshaderinc\"

void fragment() {
	vec2 n_out25p0;
// RadialShear:25
	vec2 n_in25p1 = vec2(0.50000, 0.50000);
	float n_in25p2 = 10.00000;
	vec2 n_in25p3 = vec2(0.00000, 0.00000);
	{
		n_out25p0 = radial_shear_uv(UV, n_in25p1, n_in25p2, n_in25p3);
	}


	vec2 n_out24p0;
// Spherize:24
	vec2 n_in24p1 = vec2(0.50000, 0.50000);
	float n_in24p2 = 10.00000;
	vec2 n_in24p3 = vec2(0.00000, 0.00000);
	{
		n_out24p0 = spherize_uv(n_out25p0, n_in24p1, n_in24p2, n_in24p3);
	}


// Texture2D:20
	vec4 n_out20p0 = texture(tex_frg_20, n_out24p0);


// Texture2D:19
	vec4 n_out19p0 = texture(tex_frg_19, vec2(n_out20p0.xy));


// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, vec2(n_out19p0.xy));
	float n_out3p1 = n_out3p0.r;


// Input:8
	vec2 n_out8p0 = UV;


// VectorOp:10
	vec2 n_in10p1 = vec2(0.50000, 0.50000);
	vec2 n_out10p0 = n_out8p0 - n_in10p1;


// VectorLen:7
	float n_out7p0 = length(n_out10p0);


// FloatOp:11
	float n_in11p0 = 0.50000;
	float n_out11p0 = n_in11p0 - n_out7p0;


// Mix:12
	float n_in12p2 = 1.29000;
	float n_out12p0 = mix(n_out3p1, n_out11p0, n_in12p2);


// SmoothStep:13
	float n_in13p0 = 0.50000;
	float n_in13p1 = 0.45000;
	float n_out13p0 = smoothstep(n_in13p0, n_in13p1, n_out7p0);


// FloatOp:14
	float n_out14p0 = n_out12p0 * n_out13p0;


// IntConstant:18
	int n_out18p0 = 5;


// FloatOp:15
	float n_out15p0 = n_out14p0 * float(n_out18p0);


// FloatFunc:17
	float n_out17p0 = floor(n_out15p0);


// FloatOp:16
	float n_out16p0 = n_out17p0 / float(n_out18p0);


// Output:0
	COLOR.rgb = vec3(n_out16p0);
	COLOR.a = n_out13p0;


}
"
