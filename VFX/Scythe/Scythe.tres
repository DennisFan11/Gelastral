[resource]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D curve_frg_85 : repeat_disable;
uniform sampler2D Texture2DParameter2 : source_color, filter_nearest, repeat_enable;
uniform sampler2D tex_frg_92;
uniform sampler2D tex_frg_69;
uniform sampler2D tex_frg_70;
uniform sampler2D Texture2DParameter : source_color, filter_linear, repeat_enable;
uniform sampler2D tex_frg_25;
uniform sampler2D curve_frg_110 : repeat_disable;



void fragment() {
// Input:12
	float n_out12p0 = TIME;


// FloatOp:17
	float n_in17p1 = 1.50000;
	float n_out17p0 = n_out12p0 * n_in17p1;


// FloatFunc:16
	float n_out16p0 = fract(n_out17p0);


// CurveTexture:85
	float n_out85p0 = texture(curve_frg_85, vec2(n_out16p0)).r;


// FloatOp:14
	float n_in14p1 = 2.00000;
	float n_out14p0 = n_out85p0 * n_in14p1;


// FloatOp:15
	float n_in15p1 = 0.50000;
	float n_out15p0 = n_out14p0 - n_in15p1;


// VectorCompose:102
	float n_in102p1 = 0.00000;
	vec2 n_out102p0 = vec2(n_out15p0, n_in102p1);


// Input:98
	vec2 n_out98p0 = UV;


// VectorOp:99
	vec2 n_out99p0 = n_out102p0 + n_out98p0;


	vec4 n_out103p0;
// Texture2D:103
	n_out103p0 = texture(Texture2DParameter2, n_out99p0);
	float n_out103p1 = n_out103p0.r;


// VectorCompose:91
	float n_in91p1 = 0.00000;
	vec2 n_out91p0 = vec2(n_out103p1, n_in91p1);


// Texture2D:92
	vec4 n_out92p0 = texture(tex_frg_92, n_out91p0);


// Input:76
	vec2 n_out76p0 = UV;


// VectorCompose:75
	float n_in75p1 = 0.00000;
	vec2 n_out75p0 = vec2(n_out15p0, n_in75p1);


// VectorOp:77
	vec2 n_out77p0 = n_out76p0 + n_out75p0;


// VectorOp:90
	vec2 n_in90p1 = vec2(0.00000, 0.00000);
	vec2 n_out90p0 = n_out77p0 + n_in90p1;
	float n_out90p1 = n_out90p0.r;
	float n_out90p2 = n_out90p0.g;


// Texture2D:69
	vec4 n_out69p0 = texture(tex_frg_69, n_out90p0);


// FloatOp:72
	float n_in72p0 = 1.00000;
	float n_out72p0 = n_in72p0 - n_out90p1;


// VectorCompose:73
	vec2 n_out73p0 = vec2(n_out72p0, n_out90p2);


// Texture2D:70
	vec4 n_out70p0 = texture(tex_frg_70, n_out73p0);


// FloatOp:74
	float n_out74p0 = n_out69p0.x * n_out70p0.x;


// Input:58
	vec2 n_out58p0 = UV;
	float n_out58p1 = n_out58p0.r;


// FloatOp:80
	float n_in80p1 = 0.50000;
	float n_out80p0 = n_out58p1 - n_in80p1;


// FloatFunc:81
	float n_out81p0 = abs(n_out80p0);


// FloatOp:82
	float n_in82p1 = 4.00000;
	float n_out82p0 = n_out81p0 * n_in82p1;


// FloatOp:83
	float n_in83p0 = 2.00000;
	float n_out83p0 = n_in83p0 - n_out82p0;


// Clamp:84
	float n_in84p1 = 0.00000;
	float n_in84p2 = 1.00000;
	float n_out84p0 = clamp(n_out83p0, n_in84p1, n_in84p2);


// FloatOp:78
	float n_out78p0 = n_out74p0 * n_out84p0;


// FloatOp:94
	float n_out94p0 = n_out103p1 * n_out78p0;


// SmoothStep:93
	float n_in93p0 = 0.00000;
	float n_in93p1 = 1.00000;
	float n_out93p0 = smoothstep(n_in93p0, n_in93p1, n_out94p0);


// VectorOp:107
	vec3 n_out107p0 = vec3(n_out92p0.xyz) * vec3(n_out93p0);


// VectorCompose:22
	float n_in22p0 = 0.00000;
	float n_in22p1 = 0.00000;
	vec2 n_out22p0 = vec2(n_in22p0, n_in22p1);


// Input:20
	vec2 n_out20p0 = UV;


// VectorOp:23
	vec2 n_out23p0 = n_out22p0 - n_out20p0;


	vec4 n_out18p0;
// Texture2D:18
	n_out18p0 = texture(Texture2DParameter, n_out23p0);
	float n_out18p1 = n_out18p0.r;


// VectorCompose:26
	float n_in26p1 = 0.00000;
	vec2 n_out26p0 = vec2(n_out18p1, n_in26p1);


// Texture2D:25
	vec4 n_out25p0 = texture(tex_frg_25, n_out26p0);


// FloatOp:55
	float n_out55p0 = n_out18p1 * n_out78p0;


// SmoothStep:49
	float n_in49p0 = 0.10000;
	float n_in49p1 = 1.00000;
	float n_out49p0 = smoothstep(n_in49p0, n_in49p1, n_out55p0);


// VectorOp:108
	vec3 n_out108p0 = vec3(n_out25p0.xyz) * vec3(n_out49p0);


// VectorOp:109
	vec3 n_out109p0 = n_out107p0 + n_out108p0;


// FloatConstant:114
	float n_out114p0 = 3.000000;


// VectorOp:113
	vec3 n_out113p0 = n_out109p0 * vec3(n_out114p0);


// VectorFunc:115
	vec3 n_out115p0 = floor(n_out113p0);


// VectorOp:116
	vec3 n_out116p0 = n_out115p0 / vec3(n_out114p0);


// FloatOp:104
	float n_out104p0 = n_out49p0 + n_out93p0;


// CurveTexture:110
	float n_out110p0 = texture(curve_frg_110, vec2(n_out16p0)).r;


// SmoothStep:111
	float n_in111p0 = 0.00000;
	float n_out111p0 = smoothstep(n_in111p0, n_out110p0, n_out103p1);


// FloatOp:112
	float n_out112p0 = n_out104p0 * n_out111p0;


// FloatOp:118
	float n_out118p0 = n_out112p0 * n_out114p0;


// FloatFunc:117
	float n_out117p0 = floor(n_out118p0);


// FloatOp:119
	float n_out119p0 = n_out117p0 / n_out114p0;


// Output:0
	COLOR.rgb = n_out116p0;
	COLOR.a = n_out119p0;


}
