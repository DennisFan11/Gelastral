code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D Texture2DParameter : repeat_enable;


// Ellipse
#include \"res://addons/ShaderLib_v2_2_4/Procedural/Procedural.gdshaderinc\"

void fragment() {
// Input:6
	vec4 n_out6p0 = COLOR;
	float n_out6p4 = n_out6p0.a;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Texture2DParameter, UV);


// SmoothStep:5
	float n_in5p1 = 1.00000;
	float n_out5p0 = smoothstep(n_out6p4, n_in5p1, n_out3p0.x);


	float n_out7p0;
// Ellipse:7
	float n_in7p1 = 1.00000;
	float n_in7p2 = 1.00000;
	{
		n_out7p0 = ellipse_shape(UV, n_in7p1, n_in7p2);
	}


// FloatOp:8
	float n_out8p0 = n_out5p0 * n_out7p0;


// Output:0
	COLOR.a = n_out8p0;


}
"
