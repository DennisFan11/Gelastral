code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D Texture2DParameter : repeat_enable;


// Ellipse
#include \"res://addons/ShaderLib_v2_2_4/Procedural/Procedural.gdshaderinc\"

void fragment() {
// Input:5
	vec4 n_out5p0 = COLOR;
	float n_out5p4 = n_out5p0.a;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Texture2DParameter, UV);


// SmoothStep:4
	float n_in4p1 = 1.00000;
	float n_out4p0 = smoothstep(n_out5p4, n_in4p1, n_out3p0.x);


	float n_out6p0;
// Ellipse:6
	float n_in6p1 = 1.00000;
	float n_in6p2 = 1.00000;
	{
		n_out6p0 = ellipse_shape(UV, n_in6p1, n_in6p2);
	}


// FloatOp:7
	float n_out7p0 = n_out4p0 * n_out6p0;


// Output:0
	COLOR.a = n_out7p0;


}
"
